---
interface Props {
	title: string;
}
const { title } = Astro.props;
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

const anim = {
  old: {
    name: 'fadeIn',
    duration: '0.2s',
    easing: 'linear',
    fillMode: 'forwards',
  },
  new: {
    name: 'fadeOut',
    duration: '0.3s',
    easing: 'linear',
    fillMode: 'backwards',
  }
};

const myFade = {
  forwards: anim,
  backwards: anim,
};
---
<!doctype html>
<html lang="en" transition:animate="none">
	<head>
		 <!-- meta tags: HTML -->
		 <meta charset="UTF-8">
		 <title>{title}</title>
		 <meta name="author" content="Elmahdi KORFED" />
		 <meta name="title" content="Elmahdi KORFED">
		 <meta name="description" content="Elmahdi KORFED, développeur web France" />
		 <meta name="keywords" content="Elmahdi Korfed, Developer, Web, France" />
		 <meta name="viewport" content="width=device-width" />
		 <meta name="theme-color" content="#263238">
	   
		 <!-- meta tags: OPEN GRAPH -->
		 <meta property="og:type" content="website" />
		 <meta property="og:site_name" content="Elmahdi KORFED" />
		 <meta property="og:title" content="Elmahdi KORFED" />
		 <meta property="og:image" content="/ek.webp" />
		 <meta property="og:description" content="Elmahdi KORFED, développeur web France" />
		 <meta property="og:url" content="https://elmahdik.github.io/" />
		 <meta property="og:locale" content="en_US" />

		<link rel="icon" type="image/svg+xml" href="/logo/icon_16.ico" />
		<meta name="generator" content={Astro.generator} />
		<ViewTransitions />

		<script type="text/javascript">
			// Vérifie si l'utilisateur est sur GitHub Pages
			if (window.location.hostname === "elmahdik.github.io" || window.location.hostname.endsWith(".github.io")) {
				// Redirige vers Netlify si l'utilisateur est sur GitHub Pages
				window.location.href = "https://elmahdik.netlify.app";
			}
		</script>
	</head>
	<body>
		<!-- <main transition:animate={myFade}> -->
			<slot />
		<!-- </main> -->
	</body>
</html>