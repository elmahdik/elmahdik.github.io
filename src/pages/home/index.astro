---
import './style.scss';
import './style-mobile.scss';
import about from '../../data/about.json';
---

<main id="home">
	<a href="/" class="fadeIn">{about.firstname.split('').map(e=><span>{e}</span>)} {about.lastname.split('').map(e=><span>{e}</span>)}</a>
	<p class="fadeIn">{about.sentence.split('').map(e=><span>{e}</span>)} <span class="span-hand">👋</span></p>
</main>

<script>
	import confetti from "canvas-confetti";
	confetti();
</script>