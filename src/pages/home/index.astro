---
import "./style.scss";
import "./style-mobile.scss";
---

<main id="home">
  <p>
    <span>Hi <span class="greetings">👋</span> I'm <b>Elmahdi</b> 👨🏻‍💻</span><br
    />
    <span id="span--position">✌️ Full Stack Developer</span>
  </p>
  <div id="div--down">
    <a href="#about" title="scroll down">👇</a>
  </div>
</main>

<script>
  import Typed from "typed.js";

  const typed = new Typed("#span--position", {
    strings: [
      "🎨 Frontend Developer",
      "🛠 Backend Developer",
      "✌️ Full Stack Developer",
    ],
    typeSpeed: 30,
    loop: true,
  });
</script>
