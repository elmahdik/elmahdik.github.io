---
import './style.scss';
---
<main id="contact">
    <!-- <p class="p-title"><i class="fas fa-envelope"></i></p> -->
    <form method="POST" name="contact" id="form_contact">
        <input type="text" name="name" placeholder="Name *" required>
        <input type="email" name="email" placeholder="Email *" required>
        <textarea placeholder="Write your message" name="message" required></textarea>
        <div>
          <span>Please verify you are a human 👉</span>
          <input type="text" placeholder="Answer" id="input-answer" name="answer" />
          <button id="btn-submit">send</button>
        </div>
    </form>
</main>
<script src="./main.ts"></script>