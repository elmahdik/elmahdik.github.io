---
import Card from '../../components/card/index.astro';
import projects from '../../data/projects.json';
import './style.scss';
---

<main id="portfolio">
	<ul role="list" class="link-card-grid">
		{projects.map((project) => 
			<Card
				url={project.url}
				label={project.label}
				description={project.description}
			/>
		)}
	</ul>
</main>