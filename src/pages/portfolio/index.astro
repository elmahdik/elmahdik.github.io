---
import Card from '../../components/card/index.astro';
import projects from '../../data/projects.json';
import './style.scss';
import './style-mobile.scss';
---

<main id="portfolio">
	<ul class="ul--cardgrid" role="list">
		{projects.map((project) => 
			<Card
				url={project.url}
				label={project.label}
				description={project.description}
			/>
		)}
	</ul>
</main>