---
import Layout from '../layouts/index.astro';
import Home from './home/index.astro';
import About from './about/index.astro';
import Portfolio from './portfolio/index.astro';
import Contact from './contact/index.astro';
import Nav from '../components/nav/index.astro';
import Footer from '../components/footer/index.astro';
---

<Layout title="EK • Welcome!">
    <Home />
    <section>
        <Nav />
        <About />
        <Portfolio />
        <Contact />
    </section>
    <Footer />
</Layout>

<script is:inline>
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) return localStorage.getItem('theme');
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
    return 'light';
  })();

  if (theme === 'light') document.documentElement.classList.remove('dark');
  else document.documentElement.classList.add('dark');

  window.localStorage.setItem('theme', theme);

  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");

    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  }

  Object.values(document.getElementsByClassName("themeToggle")).forEach(themeIcon => themeIcon.addEventListener("click", handleToggleClick));
</script>