---
import './style.scss';
import './style-mobile.scss';
import about from '../../data/about.json';
import { Image } from 'astro:assets';
---

<main id="about">
	<div class="div--about">
		<!-- <span>About</span> -->
		<p>{about.bio}</p>
		<a href={about.url.resume} target="_blank">resume</a>
	</div>
	<div class="div--skills">
		<span>Skills</span>
		<nav>
			{about.skills.map(skill => <Image src={`./public/skills/${skill}.png`} width="100" height="100" style="width: 100px; height: auto;" title={skill} alt={skill} />)}
		</nav>
	</div>
</main>