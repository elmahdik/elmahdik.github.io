---
import './style.scss';
import './style-mobile.scss';
import about from '../../data/about.json';
import { Image } from 'astro:assets';
let imgSrc='';

const links = [{
	"label":"Resume",
	"href":about.url.resume
}]
---

<main id="about">
	<div class="div--about">
		<p>{about.bio.split('.').map(sentence => <span>{sentence}.</span>)}</p>
		<nav>
			{links.map(link=>{return <a href={link.href} title={link.label} target="_blank"><i class="bi bi-file-pdf"></i> {link.label}</a>})}
		</nav>
	</div>
	<div class="div--skills">
		<!-- <span>&#60; Skills /&#62;</span> -->
		<nav>
			{about.skills.map(skill => {
				imgSrc=`/skills/${skill}.png`;
				return <Image src={imgSrc} width="100" height="100" style="width: calc(16.66% - 10px); height: auto;" title={skill} alt={skill} />;
			})
			}
		</nav>
	</div>
</main>