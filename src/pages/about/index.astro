---
import './style.scss';
import './style-mobile.scss';
import about from '../../data/about.json';
import { Image } from 'astro:assets';
let imgSrc='';
---

<main id="about">
	<div class="div--about">
		<!-- <span>About</span> -->
		 <Image src={'/dev.gif'} alt="dev" title="dev" width="800" height="200" style="width: 70%; height: auto" />
		<p>{about.bio.split('.').map(sentence => <span>{sentence}.</span>)}</p>
		<a href={about.url.resume} target="_blank">resume</a>
	</div>
	<div class="div--skills">
		<span>&#60; Skills /&#62;</span>
		<nav>
			{about.skills.map(skill => {
				imgSrc=`/skills/${skill}.png`;
				return <Image src={imgSrc} width="100" height="100" style="width: calc(20% - 10px); height: auto;" title={skill} alt={skill} />;
			})
			}
		</nav>
	</div>
</main>