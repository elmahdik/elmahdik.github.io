---
import { Image } from 'astro:assets';
import './style.scss';
import './style-mobile.scss';

interface Props {
	imgSrc: string;
	urlVisit: string;
	urlGithub: string;
	label: string;
	description: string;
}
const {imgSrc, urlVisit, urlGithub, label, description } = Astro.props;
---

<li class="li--card">
	<h2>{label}</h2>
	<Image src={imgSrc} alt={label} title={label} width="800" height="200" style="width: 100%; height: auto;" />
	<p>{description}</p>
	<nav>
		<a href={urlVisit} target="_blank" class="a-visit">visit</a>
		<a href={urlGithub} target="_blank" class="a-github">github</a>
	</nav>
</li>