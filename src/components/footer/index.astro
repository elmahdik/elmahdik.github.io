---
import "./style.scss";
import "./style-mobile.scss";
import ThemeIcon from "../themeIcon/index.astro";
import ButtonUp from "../buttonUp/index.astro";
import about from "../../data/about.json";
import SocialLinks from "../socialLinks/index.astro"
---

<footer>
  <div id="div--contact">
    <p>Get In Touch.</p>
    <nav>
      <a href={`mailto:${about.contact.email}?subject=Hi&body=Hello Elmahdi !`}
        >Email : {about.contact.email}</a
      >
      <a href={`tel:${about.contact.phone}`}
        >Phone : {about.contact.phone.match(/.{1,3}/g)?.join(" ")}</a
      >
    </nav>
  </div>
  <div id="div--copyright">
    <a href="/">© 2026 Elmahdi KORFED</a>
  </div>
  <div id="div--links">
    <SocialLinks />
    <ButtonUp />
    <nav>
      <ThemeIcon />
    </nav>
  </div>
</footer>
